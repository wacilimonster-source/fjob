{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fjob:widget-snapshot:v2",
  "title": "WidgetSnapshotV2",
  "description": "M7-FUND widget contract. v2 keeps every v1 field and adds one pre-computed, nullable amount: stockFundDaily. v1 snapshots remain readable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerRevision",
    "createdAt",
    "computedAt",
    "quotesAsOf",
    "validUntil",
    "timezone",
    "privacy",
    "tombstone",
    "completeness",
    "quoteQuality",
    "amounts",
    "housingMode",
    "scene",
    "caption",
    "deepLink"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ledgerRevision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "computedAt": {
      "type": "string",
      "format": "date-time"
    },
    "quotesAsOf": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Null when the summary includes a date-only fund NAV; never fabricate a quote instant."
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "privacy": {
      "type": "boolean"
    },
    "tombstone": {
      "type": "boolean"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "quoteQuality": {
      "enum": [
        "live",
        "delayed",
        "eod",
        "stale",
        "unavailable",
        "fixture"
      ]
    },
    "amounts": {
      "$ref": "#/$defs/amounts"
    },
    "housingMode": {
      "enum": [
        "mortgage",
        "rent",
        "none"
      ]
    },
    "showHousing": {
      "type": "boolean",
      "description": "住房账单已配置；旧快照缺省时按 true 显示。"
    },
    "showCar": {
      "type": "boolean",
      "description": "车贷账单已配置；旧快照缺省时按 true 显示。"
    },
    "scene": {
      "enum": [
        "working",
        "break",
        "offDuty",
        "restDay",
        "unknown"
      ]
    },
    "caption": {
      "type": "string",
      "maxLength": 100
    },
    "fundNavDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Optional business date of the fund NAV. Null when there is no fund, several distinct dates, or no NAV yet."
    },
    "deepLink": {
      "enum": [
        "fjob://dashboard",
        "fjob://expenses/housing",
        "fjob://expenses/car",
        "fjob://widgets"
      ]
    }
  },
  "$defs": {
    "amount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "wage",
        "stockDaily",
        "goldDaily",
        "stockFundDaily",
        "housing",
        "car",
        "principal",
        "interest",
        "rent"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/amount"
        },
        "wage": {
          "$ref": "#/$defs/amount"
        },
        "stockDaily": {
          "$ref": "#/$defs/amount"
        },
        "goldDaily": {
          "$ref": "#/$defs/amount"
        },
        "stockFundDaily": {
          "$ref": "#/$defs/amount",
          "description": "Dart pre-computed stock + fund sum; null when either class is incomplete."
        },
        "housing": {
          "$ref": "#/$defs/amount"
        },
        "car": {
          "$ref": "#/$defs/amount"
        },
        "principal": {
          "$ref": "#/$defs/amount"
        },
        "interest": {
          "$ref": "#/$defs/amount"
        },
        "rent": {
          "$ref": "#/$defs/amount"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "privacy": {
            "const": true
          }
        },
        "required": [
          "privacy"
        ]
      },
      "then": {
        "properties": {
          "amounts": {
            "properties": {
              "total": {
                "type": "null"
              },
              "wage": {
                "type": "null"
              },
              "stockDaily": {
                "type": "null"
              },
              "goldDaily": {
                "type": "null"
              },
              "stockFundDaily": {
                "type": "null"
              },
              "housing": {
                "type": "null"
              },
              "car": {
                "type": "null"
              },
              "principal": {
                "type": "null"
              },
              "interest": {
                "type": "null"
              },
              "rent": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tombstone": {
            "const": true
          }
        },
        "required": [
          "tombstone"
        ]
      },
      "then": {
        "properties": {
          "completeness": {
            "const": "unavailable"
          },
          "privacy": {
            "const": true
          }
        }
      }
    }
  ]
}
